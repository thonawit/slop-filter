{
  "name": "slop-filter",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that hides AI slop on X and LinkedIn, using TypeSafe's Jev model.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "experiment": "node --env-file=.env --experimental-strip-types scripts/experiment.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^24.13.6",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
